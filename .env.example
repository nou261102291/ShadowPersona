QLOO_HACKATHON_API_SERVER_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=replace-with-API-key
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-API-key
GEMINI_MODEL_ID=gemini-3.8-flash
TAVILY_API_KEY=replace-with-API-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=shadowpersona-assets
# Server-only. Never expose this key through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
GEMINI_FALLBACK_MODEL_ID=gemini-3.5-flash
GEMINI_REQUESTS_PER_MINUTE=10
# For a local OpenAI-compatible server (LM Studio or Ollama), set AI_PROVIDER=lm-studio.
# The localhost example is for local development only; Vercel needs a stable HTTPS endpoint
# reachable by its serverless functions.
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL_ID=replace-with-the-loaded-model-id
# LM_STUDIO_API_KEY=replace-with-key-if-LM-Studio-authentication-is-enabled
# The model must support vision for image/PDF uploads; PDFs are rendered as up to 12 page images.
# Set to 1 to save real demo-scenario responses to resources/demo/fixtures for offline replay
RECORD_DEMO_FIXTURES=0
