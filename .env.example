QLOO_API_KEY=replace-with-API-key
GEMINI_API_KEY=replace-with-API-key
GEMINI_MODEL_ID=gemini-3.8-flash
TAVILY_API_KEY=replace-with-API-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=shadowpersona-assets
# Server-only. Never expose this key through a NEXT_PUBLIC_ variable.
